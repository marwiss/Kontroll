# Copy to .env and edit, or let `opencde init --dev` / `opencde init --public-url https://...`
# write it with fresh secrets. Every variable is read by the server (prefix OPENCDE_) or by
# docker compose. .env is git-ignored; never commit it.

# development | test | production. Production requires an https OPENCDE_PUBLIC_URL,
# a database password and a secret key.
OPENCDE_ENVIRONMENT=development

# The URL clients use to reach this server. Appears in links and OAuth2 metadata.
OPENCDE_PUBLIC_URL=http://localhost:8000

# Signs form tokens and session cookies. At least 32 characters in production.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
OPENCDE_SECRET_KEY=

# Graph database. Inside docker compose the URI is set to bolt://graph:7687 automatically.
# From the host, the development overlay publishes Bolt on 127.0.0.1:7697 (see OPENCDE_DEV_* below).
# Use the IP, not "localhost": Windows resolves localhost to ::1 first, where Docker does not listen.
OPENCDE_GRAPH_DIALECT=neo4j
OPENCDE_GRAPH_URI=bolt://127.0.0.1:7697
OPENCDE_GRAPH_USER=neo4j
# At least 16 characters. Generate one: python -c "import secrets; print(secrets.token_urlsafe(24))"
OPENCDE_GRAPH_PASSWORD=change-me-to-a-long-random-value

# Logging: JSON lines for production, readable console output for development.
OPENCDE_LOG_LEVEL=INFO
OPENCDE_LOG_JSON=true

# Browser clients allowed to call the API (JSON list). Bearer tokens only, never cookies.
OPENCDE_CORS_ORIGINS=["*"]

# Proxies whose X-Forwarded-* headers are trusted (JSON list of IPs or CIDRs).
OPENCDE_TRUSTED_PROXIES=["127.0.0.1"]
# NTP server for the clock check of `opencde doctor` and the settings page; empty disables the check.
# OPENCDE_NTP_SERVER=pool.ntp.org

# OAuth2. Defaults are shown; uncomment to change.
# OPENCDE_AUTHORIZATION_CODE_TTL_SECONDS=60
# OPENCDE_ACCESS_TOKEN_TTL_SECONDS=3600
# OPENCDE_REFRESH_TOKEN_TTL_SECONDS=2592000
# Offer POST /foundation/oauth2/reg (Foundation API 2.2.3). Off unless you need it.
OPENCDE_DYNAMIC_CLIENT_REGISTRATION=false
# Accept http://localhost redirect URIs besides the loopback IPs. Development only.
OPENCDE_ALLOW_LOCALHOST_REDIRECTS=false
# Self-registered clients that issue no token for this many days are deleted (`opencde client prune` does it now).
# OPENCDE_DYNAMIC_CLIENT_UNUSED_DAYS=30

# Limits. Defaults shown.
# OPENCDE_MAX_UPLOAD_BYTES=1073741824
# OPENCDE_UPLOAD_PART_BYTES=52428800
# OPENCDE_MAX_IMAGE_BYTES=10485760
# OPENCDE_RATE_LIMITS_ENABLED=true

# Optional modules.
OPENCDE_IFCGRAPH_ENABLED=false
OPENCDE_ADMIN_UI_ENABLED=true
# Interactive API documentation at /docs (Swagger UI, loaded from a CDN). Unset: only outside production.
# OPENCDE_API_DOCS_ENABLED=true
# Request log for debugging clients (method, path, status, timing, caller; never bodies or tokens),
# shown at /admin/requests and served at /admin/api/requests. Off by default; entries expire.
OPENCDE_REQUEST_LOG_ENABLED=false
# OPENCDE_REQUEST_LOG_RETENTION_HOURS=72
# JSON administration API under /admin/api (bearer tokens with the admin scope); the capabilities document
# at /.well-known/kontroll tells clients whether it is on.
OPENCDE_ADMIN_API_ENABLED=true
# Announced in the capabilities document: a Dataspatium installation to link to, and the graph database's
# Bolt address when it is deliberately published with compose.bolt.yaml (docs/deploy/bolt.md; production
# requires bolt+s:// or neo4j+s://). The development overlay publishes bolt://localhost:7697 for local tools.
# OPENCDE_DATASPATIUM_URL=https://app.example.org
# OPENCDE_GRAPH_PUBLIC_BOLT_URL=bolt+s://cde.example.org:7687
# OPENCDE_BOLT_PORT=7687
# IFC-graph limits and the property that identifies products (docs/ifcgraph.md). Defaults shown.
# OPENCDE_IFCGRAPH_TIMEOUT_SECONDS=900
# OPENCDE_IFCGRAPH_MEMORY_MB=4096
# OPENCDE_IFCGRAPH_MAX_ENTITIES=5000000
# OPENCDE_IFCGRAPH_INCLUDE_GEOMETRY=false
# OPENCDE_IFCGRAPH_GTIN_PROPERTY_SET=Reuse
# OPENCDE_IFCGRAPH_GTIN_PROPERTY=GTIN

# Memory for the Neo4j container (docker compose only).
NEO4J_HEAP=512m
NEO4J_PAGECACHE=256m

# Production (compose.prod.yaml): the public host name Caddy obtains a certificate for,
# the e-mail Let's Encrypt may contact about it, and which published image tag to run.
# OPENCDE_DOMAIN=cde.example.org
# OPENCDE_ACME_EMAIL=
# OPENCDE_IMAGE_TAG=latest

# Tunnel (compose.tunnel.yaml): the token of a Cloudflare Tunnel routed to http://api:8000.
# TUNNEL_TOKEN=

# Host ports used by compose.dev.yaml (127.0.0.1 only). Change them if they clash.
OPENCDE_DEV_PORT=8000
OPENCDE_DEV_NEO4J_HTTP_PORT=7484
OPENCDE_DEV_NEO4J_BOLT_PORT=7697
